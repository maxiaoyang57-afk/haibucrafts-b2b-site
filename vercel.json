{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/index.html",
      "destination": "/products/",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/about/index.html",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/custom-services/index.html",
      "destination": "/custom-solutions/",
      "permanent": true
    },
    {
      "source": "/quote/index.html",
      "destination": "/request-quote/",
      "permanent": true
    },
    {
      "source": "/request-quote/index.html",
      "destination": "/request-quote/",
      "permanent": true
    },
    {
      "source": "/blog/polymer-clay-slices-buying-guide.html",
      "destination": "/blog/polymer-clay-slice-buying-guide/",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/about/b2b-export-supplier.html",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/products/plastic-sequins-wholesale.html",
      "destination": "/products/sequins-glitter-confetti/",
      "permanent": true
    },
    {
      "source": "/products/resin-charms-wholesale.html",
      "destination": "/products/resin-charms-for-slime/",
      "permanent": true
    },
    {
      "source": "/products/slime-charms-wholesale.html",
      "destination": "/products/slime-charms-wholesale/",
      "permanent": true
    },
    {
      "source": "/products/polymer-clay-slices-wholesale.html",
      "destination": "/products/polymer-clay-slices-wholesale/",
      "permanent": true
    },
    {
      "source": "/products/resin-charms-for-slime.html",
      "destination": "/products/resin-charms-for-slime/",
      "permanent": true
    },
    {
      "source": "/products/sequins-glitter-confetti.html",
      "destination": "/products/sequins-glitter-confetti/",
      "permanent": true
    },
    {
      "source": "/custom-services/",
      "destination": "/custom-solutions/",
      "permanent": true
    },
    {
      "source": "/quote/",
      "destination": "/request-quote/",
      "permanent": true
    },
    {
      "source": "/haibu-manufacturing/",
      "destination": "/manufacturing/",
      "permanent": true
    },
    {
      "source": "/haibu-quality-control/",
      "destination": "/quality-control/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; media-src 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "trailingSlash": true
}
