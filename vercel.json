{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "functions": {
    "api/homepage-preview.js": {
      "includeFiles": "index.html"
    },
    "api/site-preview.js": {
      "includeFiles": "**/*.html"
    },
    "api/site-audit.js": {
      "includeFiles": "**/*.{html,xml,txt}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/site-preview?file=index.html" },
    { "source": "/index.html", "destination": "/api/site-preview?file=index.html" },
    { "source": "/homepage-preview", "destination": "/api/site-preview?file=index.html" },
    { "source": "/404.html", "destination": "/api/site-preview?file=404.html" },
    { "source": "/privacy.html", "destination": "/api/site-preview?file=privacy.html" },
    { "source": "/about", "destination": "/api/site-preview?file=about/index.html" },
    { "source": "/about/", "destination": "/api/site-preview?file=about/index.html" },
    { "source": "/about/:path*", "destination": "/api/site-preview?file=about/:path*" },
    { "source": "/applications/:path*", "destination": "/api/site-preview?file=applications/:path*" },
    { "source": "/blog", "destination": "/api/site-preview?file=blog/index.html" },
    { "source": "/blog/", "destination": "/api/site-preview?file=blog/index.html" },
    { "source": "/blog/:path*", "destination": "/api/site-preview?file=blog/:path*" },
    { "source": "/custom-services", "destination": "/api/site-preview?file=custom-services/index.html" },
    { "source": "/custom-services/", "destination": "/api/site-preview?file=custom-services/index.html" },
    { "source": "/custom-services/:path*", "destination": "/api/site-preview?file=custom-services/:path*" },
    { "source": "/products", "destination": "/api/site-preview?file=products/index.html" },
    { "source": "/products/", "destination": "/api/site-preview?file=products/index.html" },
    { "source": "/products/:path*", "destination": "/api/site-preview?file=products/:path*" },
    { "source": "/quote", "destination": "/api/site-preview?file=quote/index.html" },
    { "source": "/quote/", "destination": "/api/site-preview?file=quote/index.html" },
    { "source": "/quote/:path*", "destination": "/api/site-preview?file=quote/:path*" }
  ],
  "redirects": [
    {
      "source": "/manufacturing",
      "destination": "/about/manufacturing.html",
      "permanent": false
    },
    {
      "source": "/manufacturing/",
      "destination": "/about/manufacturing.html",
      "permanent": false
    },
    {
      "source": "/quality-control",
      "destination": "/about/quality-control.html",
      "permanent": false
    },
    {
      "source": "/quality-control/",
      "destination": "/about/quality-control.html",
      "permanent": false
    },
    {
      "source": "/products/plastic-sequins-wholesale.html",
      "destination": "/products/sequins-glitter-confetti.html",
      "permanent": true
    },
    {
      "source": "/products/resin-charms-wholesale.html",
      "destination": "/products/resin-charms-for-slime.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; media-src 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), payment=()" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
